FROM python:3.12-slim

# Install uv for fast dependency installation
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Install dependencies with layer caching
COPY demo/requirements.txt /app/demo/requirements.txt
RUN uv pip install --system -r /app/demo/requirements.txt

# Copy demo code
COPY demo /app/demo

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Default command (overridden per service in docker-compose)
CMD ["uvicorn", "demo.services.gateway:app", "--host", "0.0.0.0", "--port", "8001"]
